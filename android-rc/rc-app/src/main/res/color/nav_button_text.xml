<?xml version="1.0" encoding="utf-8"?>
<!-- Nav text: selected pairs with the filled primary background
     (ksi_on_primary); unselected is ksi_muted on transparent; disabled is
     ksi_muted on surface_subtle (background carries the distinction). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ksi_muted" />
    <item android:state_selected="true" android:color="@color/ksi_on_primary" />
    <item android:color="@color/ksi_muted" />
</selector>
