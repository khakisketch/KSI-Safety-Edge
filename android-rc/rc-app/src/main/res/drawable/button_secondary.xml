<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary (default button): outlined, ksi_surface fill + ksi_border
     stroke. Pressed drops to surface_subtle; focused thickens the stroke to
     ksi_muted; disabled is surface_subtle/border. Rounded 6dp, no shadow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ksi_surface_subtle" />
            <stroke android:width="1dp" android:color="@color/ksi_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ksi_surface_subtle" />
            <stroke android:width="1dp" android:color="@color/ksi_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ksi_surface" />
            <stroke android:width="2dp" android:color="@color/ksi_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ksi_surface" />
            <stroke android:width="1dp" android:color="@color/ksi_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
