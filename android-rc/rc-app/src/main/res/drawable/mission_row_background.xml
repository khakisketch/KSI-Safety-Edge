<?xml version="1.0" encoding="utf-8"?>
<!-- Mission selection, not an assessment of flight safety. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ksi_border">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/ksi_surface_subtle" />
                    <stroke android:width="2dp" android:color="@color/ksi_primary" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/ksi_candidate_selected_bg" />
                    <stroke android:width="1dp" android:color="@color/ksi_primary" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ksi_surface" />
                    <stroke android:width="1dp" android:color="@color/ksi_border" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
