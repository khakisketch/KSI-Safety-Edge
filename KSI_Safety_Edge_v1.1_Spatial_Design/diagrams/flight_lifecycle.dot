digraph G {
 graph [rankdir=LR, bgcolor="white", pad=0.38, nodesep=0.40, ranksep=0.55, splines=ortho, label="KSI Safety  |  웹 준비 → 오프라인 비행 → 동기화 → 사후 검토", labelloc=t, fontname="NanumSquare", fontsize=22, fontcolor="#162B4B"];
 node [fontname="NanumSquare", fontsize=12, shape=box, style="rounded,filled", margin="0.22,0.15", color="#A6B8C6", fontcolor="#14253D"];
 edge [fontname="NanumSquare", fontsize=11, color="#506982", penwidth=1.6, arrowsize=0.7];
 a [label="① 준비\n웹/RC 현장·위험구역 작성\n임무/Zone Snapshot",fillcolor="#F1EAFF"];
