digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.38, ranksep=0.52, nodesep=0.48, splines=polyline, label="사건 판단과 증거의 계보  |  원본은 불변", labelloc=t, fontname="NanumSquare", fontsize=23, fontcolor="#162B4B"];
 node [fontname="NanumSquare", fontsize=12, shape=box, style="rounded,filled", margin="0.20,0.12", color="#A9BFD1", fontcolor="#14253D"];
 edge [fontname="NanumSquare", fontsize=10, color="#718498", penwidth=1.5];
 event [label="Edge 최초 탐지·Event\n모델/프레임/좌표/Zone 버전\n원본 불변",fillcolor="#DEECFF",color="#2E79C9",penwidth=2];
 artifact [label="원본 증거\n스냅샷·클립·RC 프록시\nSHA-256/시각/출처",fillcolor="#E8F3FF"];
 human [label="사람의 현장 의견\n오탐 의심 · 확인 필요\n승인 강제 없음",fillcolor="#E1F5E9"];
 vlm [label="사후 VLM 제안\n오탐 후보 · 미탐 후보 · 불확실\n모델/프롬프트 버전",fillcolor="#FFF0DF"];
 gt [label="독립 검증된 정답 라벨\n사람 검증 + 근거\n학습 데이터는 별도 승인",fillcolor="#F1EAFE"];
 event->artifact [label="연결"];
 event->human [label="Annotation append-only"];
 event->vlm [label="ReviewFinding 별도"];
 human->gt [style=dashed,label="검증 후에만"];
 vlm->gt [style=dashed,label="검증 후에만"];
}
