digraph G {
 graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.26, nodesep=0.45, ranksep=0.62, splines=polyline, fontname="NanumSquare", label="KSI Safety Edge  |  설계 책임과 정보 흐름", labelloc=t, fontsize=24, fontcolor="#1A3051"];
